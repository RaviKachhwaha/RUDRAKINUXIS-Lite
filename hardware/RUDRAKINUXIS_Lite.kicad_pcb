(kicad_pcb
  (version 20260101)
  (generator "RUDRAKINUXIS_Setup")
  (generator_version "10.0")
  (general (thickness 1.6))
  (paper "A3")
  (title_block
    (title "RUDRAKINUXIS_Lite - 500W-600W FOC Motor Inverter PCBA")
    (date "2026-09-10")
    (rev "v1.0")
    (company "Engineered by Ravi Kachhwaha")
  )
  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" power "GND")
    (2 "In2.Cu" power "VCC")
    (31 "B.Cu" signal "Bottom_Bypass")
    (36 "B.SilkS" user)
    (37 "F.SilkS" user)
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0.05)
    (solder_mask_min_width 0.10)
    (stackup
      (layer "F.SilkS" (type "Top Silk Screen"))
      (layer "F.Mask" (type "Top Solder Mask") (thickness 0.01))
      (layer "F.Cu" (type "copper") (thickness 0.070))
      (layer "dielectric 1" (type "prepreg") (thickness 0.21) (material "FR4") (epsilon_r 4.5))
      (layer "In1.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 2" (type "core") (thickness 1.06) (material "FR4") (epsilon_r 4.5))
      (layer "In2.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 3" (type "prepreg") (thickness 0.21) (material "FR4") (epsilon_r 4.5))
      (layer "B.Cu" (type "copper") (thickness 0.070))
      (layer "B.Mask" (type "Solder Mask") (thickness 0.01))
      (layer "B.SilkS" (type "Bottom Silk Screen"))
      (copper_finish "HASL Lead Free")
    )
    (design_rules
      (min_track_width 0.15)
      (min_via_diameter 0.60)
      (min_via_annular_ring 0.15)
      (min_copper_edge_clearance 0.50)
      (min_clearance 0.15)
    )
  )
  (net 0 "")
  (net 1 "GND")
  (net 2 "V_BAT")
  (net 3 "+5V_BUCK")
  (net 4 "+3V3_SYS")
  (net 5 "MOTOR_U")
  (net 6 "MOTOR_V")
  (net 7 "MOTOR_W")
  (net 8 "DSHOT_PWM")
  (net 9 "TLM_TX")
  (net 10 "BIDIR_RX")
  (net 11 "CAN_H")
  (net 12 "CAN_L")
  (net 13 "VBUS_USB")

  ;; ------------------------------------------------------------------------
  ;; COMPACT FORM FACTOR BOARD OUTLINE (65.0mm x 55.0mm)
  ;; ------------------------------------------------------------------------
  (gr_line (start 0 0) (end 65 0) (layer "Edge.Cuts") (width 0.15))
  (gr_line (start 65 0) (end 65 55) (layer "Edge.Cuts") (width 0.15))
  (gr_line (start 65 55) (end 0 55) (layer "Edge.Cuts") (width 0.15))
  (gr_line (start 0 55) (end 0 0) (layer "Edge.Cuts") (width 0.15))

  ;; ------------------------------------------------------------------------
  ;; M3 CORNER MOUNTING HOLES (3.2mm Diameter)
  ;; ------------------------------------------------------------------------
  (gr_circle (center 3.5 3.5) (end 5.1 3.5) (layer "Edge.Cuts") (width 0.15))
  (gr_circle (center 61.5 3.5) (end 63.1 3.5) (layer "Edge.Cuts") (width 0.15))
  (gr_circle (center 3.5 51.5) (end 5.1 51.5) (layer "Edge.Cuts") (width 0.15))
  (gr_circle (center 61.5 51.5) (end 63.1 51.5) (layer "Edge.Cuts") (width 0.15))

  ;; ------------------------------------------------------------------------
  ;; 5x HEAVY DIRECT-SOLDER PADS WITH WIRE ANCHOR HOLE & THERMAL MATRIX
  ;; ------------------------------------------------------------------------
  ;; Pad 1: BAT+ (7.0mm pad with 2.2mm wire insertion hole for 10AWG/12AWG)
  (footprint "Custom_Pads:Pad_10x7mm_WireHole" (layer "F.Cu")
    (at 8.0 12.0)
    (pad "1" thru_hole circle (at 0 0) (size 7.0 7.0) (drill 2.2) (layers "*.Cu" "F.Mask" "B.Mask") (net 2 "V_BAT"))
    (fp_text reference "BAT+" (at 0 -4.8) (layer "F.SilkS") (effects (font (size 1.0 1.0) (thickness 0.15))))
  )

  ;; Pad 2: BAT- / GND (7.0mm pad with 2.2mm wire insertion hole for 10AWG/12AWG)
  (footprint "Custom_Pads:Pad_10x7mm_WireHole" (layer "F.Cu")
    (at 8.0 24.0)
    (pad "1" thru_hole circle (at 0 0) (size 7.0 7.0) (drill 2.2) (layers "*.Cu" "F.Mask" "B.Mask") (net 1 "GND"))
    (fp_text reference "BAT-" (at 0 -4.8) (layer "F.SilkS") (effects (font (size 1.0 1.0) (thickness 0.15))))
  )

  ;; Pad 3: Motor Phase U (7.0mm pad with 2.2mm wire insertion hole)
  (footprint "Custom_Pads:Pad_10x7mm_WireHole" (layer "F.Cu")
    (at 57.0 11.0)
    (pad "1" thru_hole circle (at 0 0) (size 7.0 7.0) (drill 2.2) (layers "*.Cu" "F.Mask" "B.Mask") (net 5 "MOTOR_U"))
    (fp_text reference "PHASE_U" (at 0 -4.8) (layer "F.SilkS") (effects (font (size 1.0 1.0) (thickness 0.15))))
  )

  ;; Pad 4: Motor Phase V (7.0mm pad with 2.2mm wire insertion hole)
  (footprint "Custom_Pads:Pad_10x7mm_WireHole" (layer "F.Cu")
    (at 57.0 27.5)
    (pad "1" thru_hole circle (at 0 0) (size 7.0 7.0) (drill 2.2) (layers "*.Cu" "F.Mask" "B.Mask") (net 6 "MOTOR_V"))
    (fp_text reference "PHASE_V" (at 0 -4.8) (layer "F.SilkS") (effects (font (size 1.0 1.0) (thickness 0.15))))
  )

  ;; Pad 5: Motor Phase W (7.0mm pad with 2.2mm wire insertion hole)
  (footprint "Custom_Pads:Pad_10x7mm_WireHole" (layer "F.Cu")
    (at 57.0 44.0)
    (pad "1" thru_hole circle (at 0 0) (size 7.0 7.0) (drill 2.2) (layers "*.Cu" "F.Mask" "B.Mask") (net 7 "MOTOR_W"))
    (fp_text reference "PHASE_W" (at 0 -4.8) (layer "F.SilkS") (effects (font (size 1.0 1.0) (thickness 0.15))))
  )
)
